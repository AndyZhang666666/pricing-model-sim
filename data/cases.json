      "customRetention": {
        "anchors": [
          { "day": 1, "retention": 0.2 },
          { "day": 7, "retention": 0.08 },
          { "day": 30, "retention": 0.03 },
          { "day": 90, "retention": 0.012 },
          { "day": 180, "retention": 0.006 }
        ],
        "alpha": 0.5
      },
      "params": {
        "common": {
          "cac": 12,
          "platformCut": 0.15,
          "newUsersPerMonth": 3000,
          "discountMonthly": 0
        },
        "unlock": {
          "pricePerUnlock": 5.0,
          "unlocksPerPayerMonth": 1.2,
          "payerShare": 0.15,
          "payerDecay": 0.85,
          "freeEpisodes": 0,
          "episodesPerMonth": 8
        },
        "subscription": {
          "monthlyPrice": 19.9,
          "trialDays": 7,
          "trialOptIn": 0.4,
          "trialToPaid": 0.3
        },
        "hybrid": { "unlockThreshold": 2, "switchRate": 0.2 }
      },
      "comment": "低留存值得优先诊断，但不能由一个 D30 数字断言所有机制都无效，也不存在统一的留存及格线。先核对首轮价值、用户是否完成核心任务、获客质量和成本口径，再决定先改善留存还是测试收费。模型结果只能说明这组假设下的情况，不替代用户证据。",
      "commentBasis": "conclusion"
    }
  ]
}
